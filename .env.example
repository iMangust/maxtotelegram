# --- Режим источника MAX ---
# auto (по умолчанию): user, если заданы MAX_USER_TOKEN+MAX_DEVICE_ID, иначе bot.
# MAX_MODE=auto
#
# РЕЖИМ USER (рекомендуется для личного дублирования ВСЕХ сообщений,
# включая личные от незнакомцев — бота никуда добавлять не нужно):
#   1. Откройте https://web.max.ru в браузере и войдите в аккаунт.
#   2. F12 -> Application (Chrome) / Storage (Firefox) -> Local Storage.
#   3. Скопируйте:
#      __oneme_auth -> поле "token" (не весь JSON!)  -> MAX_USER_TOKEN
#      __oneme_device_id                             -> MAX_DEVICE_ID
# ВНИМАНИЕ: это неофициальный протокол веб-клиента (userbot). Он нарушает
# пользовательское соглашение MAX и может привести к блокировке аккаунта —
# используйте на свой страх и риск. Токен даёт полный доступ к аккаунту!
#
# БЕЗОПАСНОСТЬ (обязательно):
#   1. Явное согласие на риски — без этой строки приложение НЕ запустится
#      в user-режиме:
# USER_MODE_ACK=yes
#   2. Храните токен в файле с правами 600, а не в этом .env:
#        echo 'ВАШ_ТОКЕН' > ~/.max_token && chmod 600 ~/.max_token
#      и укажите путь вместо MAX_USER_TOKEN:
# MAX_USER_TOKEN_FILE=~/.max_token
# MAX_USER_TOKEN=xxxx
# MAX_DEVICE_ID=xxxx
# Белый список чатов (пусто = пересылать ВСЕ диалоги и чаты):
# MAX_CHAT_IDS=100,200
# Исключить чаты из пересылки (работает даже в списке выше):
# MAX_EXCLUDE_CHAT_IDS=-758
#
# РЕЖИМ BOT (официальный Bot API, @MasterBot): видит только чаты, куда
# добавлен бот; личные сообщения от незнакомцев НЕ перехватывает.
# MAX_BOT_TOKEN=xxxx
TG_BOT_TOKEN=xxxx
# Личный чат Telegram, куда дублировать сообщения из MAX.
# Проще всего: напишите своему боту /start в личку, затем откройте
# https://t.me/userinfobot — он покажет ваш chat id (число).
TG_CHAT_ID=-1001234567890

# --- Режимы пересылки (личный сценарий: оставьте просто TG_CHAT_ID) ---
# По умолчанию пересылаются ЛИЧНЫЕ сообщения вам в MAX + ВСЕ чаты, где состоит бот.
# FORWARD_ALL_CHATS=true        # то же самое явно
# FORWARD_ALL_CHATS=false       # пересылать только личные + чаты из CHAT_MAP/MAX_FORWARD_CHATS
# Чаты можно включать/выключать на лету командами /forward <id>, /unforward <id>
# (список id чатов — команда /chats в Telegram).

# Опционально: точечные маппинги "maxChatId:tgChatId,..."
# CHAT_MAP=12345:-100111,67890:-100222
# Опционально: статичный список чатов для пересылки через /forward
# MAX_FORWARD_CHATS=12345,67890
# Опционально: кому разрешены команды управления мостом (через запятую)
# По умолчанию команды принимает только владелец (тот, чей TG_CHAT_ID).
# Расширенный белый список id Telegram-пользователей (через запятую):
# ALLOWED_TG_USER_IDS=11111111
# DEBUG=true
