# Токен бота MAX (получить через MAX Messenger @MasterBot)
MAX_BOT_TOKEN=xxxx
# Токен бота Telegram (BotFather)
TG_BOT_TOKEN=xxxx
# Личный чат Telegram, куда дублировать сообщения из MAX.
# Проще всего: напишите своему боту /start в личку, затем откройте
# https://t.me/userinfobot — он покажет ваш chat id (число).
TG_CHAT_ID=-1001234567890

# --- Режимы пересылки (личный сценарий: оставьте просто TG_CHAT_ID) ---
# По умолчанию пересылаются ЛИЧНЫЕ сообщения вам в MAX + ВСЕ чаты, где состоит бот.
# FORWARD_ALL_CHATS=true        # то же самое явно
# FORWARD_ALL_CHATS=false       # пересылать только личные + чаты из CHAT_MAP/MAX_FORWARD_CHATS
# Чаты можно включать/выключать на лету командами /forward <id>, /unforward <id>
# (список id чатов — команда /chats в Telegram).

# Опционально: точечные маппинги "maxChatId:tgChatId,..."
# CHAT_MAP=12345:-100111,67890:-100222
# Опционально: статичный список чатов для пересылки через /forward
# MAX_FORWARD_CHATS=12345,67890
# Опционально: кому разрешены команды управления мостом (через запятую)
# ALLOWED_TG_USER_IDS=11111111
# DEBUG=true
